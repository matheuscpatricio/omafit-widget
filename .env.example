# URL pública do site (SEO, Open Graph, JSON-LD). Ex.: https://www.omafit.co
VITE_SITE_URL=https://omafit.co

# Supabase Configuration (no build, o Vite injeta dns-prefetch/preconnect no index.html para esta origem)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Fal.ai API Key (for edge functions)
FAL_KEY=your_fal_ai_api_key

# App Omafit (Railway / backend): consultor + pesquisa de catálogo no chat + telemetria de sugestões (impressão / clique / ATC)
# O segredo NÃO está neste repo — existe só como variável de ambiente na app que expõe /api/widget/catalog-search.
# O mesmo segredo e base URL servem para POST /api/widget/suggestion-events e catalog-search (incl. filtro por género).
#
# Onde achar ou criar:
# 1) Railway → serviço da app Omafit (backend) → Variables → procure WIDGET_CATALOG_HMAC_SECRET ou OMAFIT_WIDGET_HMAC_SECRET.
# 2) Se não existir nenhuma das duas: crie WIDGET_CATALOG_HMAC_SECRET com um valor longo e aleatório (ex.: openssl rand -hex 32),
#    faça deploy do backend para ele passar a validar assinaturas com esse valor, e use o MESMO texto abaixo no build do widget.
#
# VITE_OMAFIT_APP_URL=https://sua-app-omafit.up.railway.app
# VITE_OMAFIT_WIDGET_HMAC_SECRET=cole_aqui_o_mesmo_valor_que_WIDGET_CATALOG_HMAC_SECRET_no_railway
# Alias opcional (equivalente):
# VITE_WIDGET_CATALOG_HMAC_SECRET=cole_o_mesmo_valor