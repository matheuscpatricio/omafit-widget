# URL pública do site (SEO, Open Graph, JSON-LD). Ex.: https://www.omafit.co
VITE_SITE_URL=https://omafit.co

# Supabase Configuration (no build, o Vite injeta dns-prefetch/preconnect no index.html para esta origem)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Fal.ai API Key (for edge functions)
FAL_KEY=your_fal_ai_api_key

# App Omafit (Railway): consultor + pesquisa de catálogo no chat
# URL pública da app (sem barra final). Segredo = mesmo valor que WIDGET_CATALOG_HMAC_SECRET (ou OMAFIT_WIDGET_HMAC_SECRET) no Railway.
# VITE_OMAFIT_APP_URL=https://omafit-production.up.railway.app
# VITE_OMAFIT_WIDGET_HMAC_SECRET=your_shared_hmac_secret
# Alias opcional (equivalente ao de cima):
# VITE_WIDGET_CATALOG_HMAC_SECRET=your_shared_hmac_secret