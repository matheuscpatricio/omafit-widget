{
  "vendor": "omafit",
  "name": "store-widget",
  "version": "0.1.0",
  "title": "Omafit",
  "description": "Provador virtual, recomendação de tamanho e consultor Omafit na página de produto.",
  "categories": [],
  "builders": {
    "react": "3.x",
    "messages": "1.x",
    "store": "0.x",
    "admin": "0.x",
    "docs": "0.x"
  },
  "dependencies": {
    "vtex.styleguide": "9.x",
    "vtex.product-context": "0.x",
    "vtex.render-runtime": "8.x",
    "vtex.css-handles": "1.x",
    "vtex.order-items": "0.x",
    "vtex.apps-graphql": "3.x"
  },
  "peerDependencies": {
    "vtex.store": "2.x"
  },
  "settingsSchema": {
    "title": "Omafit",
    "type": "object",
    "properties": {
      "publicId": {
        "title": "ID público do widget",
        "description": "Copie o public_id (wgt_pub_…) em omafit.co, no gerador do widget. Não cole a chave privada.",
        "type": "string",
        "default": ""
      },
      "widgetEnabled": {
        "title": "Widget ativo na loja",
        "type": "boolean",
        "default": true
      },
      "widgetBaseUrl": {
        "title": "URL base do widget",
        "description": "Padrão https://omafit.co/widget. Só altere para um ambiente de homologação HTTPS.",
        "type": "string",
        "default": "https://omafit.co/widget"
      },
      "linkText": {
        "title": "Texto do botão",
        "description": "Vazio usa a tradução da loja (pt, en ou es).",
        "type": "string",
        "default": ""
      },
      "primaryColor": {
        "title": "Cor do botão",
        "type": "string",
        "default": "#810707"
      },
      "ctaType": {
        "title": "Tipo do botão",
        "type": "string",
        "enum": ["link", "button"],
        "default": "link"
      },
      "ctaBorderRadius": {
        "title": "Raio da borda do botão (px)",
        "type": "number",
        "default": 40
      },
      "tryonLayout": {
        "title": "Layout do provador",
        "type": "string",
        "enum": ["default", "hero", "sidebar"],
        "default": "default"
      },
      "entry": {
        "title": "Experiência",
        "description": "tryon abre /widget. footwear-ar abre /widget-shoes (AR de calçado; sem GLB o widget usa um modelo de exemplo).",
        "type": "string",
        "enum": ["tryon", "footwear-ar"],
        "default": "tryon"
      },
      "defaultGender": {
        "title": "Gênero padrão da tabela",
        "type": "string",
        "enum": ["", "male", "female", "unisex"],
        "default": ""
      },
      "storeName": {
        "title": "Nome da loja no widget",
        "type": "string",
        "default": ""
      },
      "excludedCategories": {
        "title": "Categorias sem widget",
        "description": "Nomes, slugs ou ids separados por vírgula. O bloco some nessas categorias.",
        "type": "string",
        "default": ""
      }
    }
  },
  "billingOptions": {
    "type": "free",
    "support": {
      "email": "contato@omafit.co",
      "url": "https://omafit.co"
    },
    "availableCountries": ["*"]
  },
  "$schema": "https://raw.githubusercontent.com/vtex/node-vtex-api/master/gen/manifest.schema"
}
