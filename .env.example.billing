# ============================================
# Shopify Billing - Variáveis de Ambiente
# ============================================

# Supabase Configuration
# Obtenha no Supabase Dashboard → Settings → API
SUPABASE_URL=https://lhkgnirolvbmomeduoaj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Shopify App URL
# URL pública onde seu app está hospedado
# Usado para o returnUrl do billing
SHOPIFY_APP_URL=https://omafit-app.fly.dev

# Shopify App Configuration (você já deve ter estas)
SHOPIFY_API_KEY=sua_api_key
SHOPIFY_API_SECRET=seu_api_secret

# Opcional: Secret para proteger endpoints de cron
CRON_SECRET=algum_secret_aleatório_aqui

# ============================================
# Notas:
# ============================================
#
# 1. SUPABASE_SERVICE_ROLE_KEY:
#    - Esta é a chave PRIVADA do Supabase
#    - NUNCA exponha no frontend
#    - Só use no backend (server-side)
#    - Tem permissões de admin
#
# 2. SHOPIFY_APP_URL:
#    - Deve ser a URL pública do seu app
#    - Usado em: returnUrl no billing
#    - Exemplos:
#      - https://seu-app.fly.dev
#      - https://omafit-shopify-app.herokuapp.com
#      - https://app.omafit.com
#
# 3. CRON_SECRET:
#    - Usado para proteger endpoints de cron
#    - Opcional se você não usar cron jobs
#    - Pode ser qualquer string aleatória
#
# ============================================
